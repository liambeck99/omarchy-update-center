#!/bin/bash

# Collect everything Update Center shows, as one JSON document on stdout.
#
#   update-center-status [--skip system,aur,mise,flatpak,plugins,omarchy]   full check (uses the network)
#   update-center-status busy                                 is an update running right now?
#
# Each source reports {enabled, available, ok, error, packages[]}, where a
# package is {name, from, to}. A plugin that omarchy-plugin-update can't
# fast-forward is still listed, flagged localEdits: true (uncommitted changes to
# tracked files) or localCommits: true (commits of its own), so the panel leaves
# it out of the count. A source that fails keeps ok=false and its error text;
# the panel keeps the previous result for it, unless it also says partial: true
# (some plugins were checked, the rest couldn't be reached). Nothing here needs
# root: checkupdates syncs into a temporary database, and yay -Qua, mise and
# flatpak remote-ls only read.
#
# A plugin's package also carries title, the name in its manifest, when that
# differs from its folder id. It is for display only: name stays the id.

set -uo pipefail

PACMAN_LOG=${UPDATE_CENTER_PACMAN_LOG:-/var/log/pacman.log}
PACMAN_LOCK=${UPDATE_CENTER_PACMAN_LOCK:-/var/lib/pacman/db.lck}
UPDATE_LOCK=${UPDATE_CENTER_UPDATE_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-update.lock}
CHECK_TIMEOUT=${UPDATE_CENTER_TIMEOUT:-120}
PLUGINS_DIR=${UPDATE_CENTER_PLUGINS_DIR:-${HOME:-}/.config/omarchy/plugins}

# omarchy-update holds its lock for the whole run (pacman, AUR, mise), and a
# hand-run pacman holds db.lck. Either one means an update is in progress.
busy() {
  [[ -e $PACMAN_LOCK ]] && return 0
  [[ -e $UPDATE_LOCK ]] && ! flock -n "$UPDATE_LOCK" true 2>/dev/null && return 0
  return 1
}

# The last full system upgrade pacman logged, as epoch seconds.
last_update() {
  local line stamp
  [[ -r $PACMAN_LOG ]] || return 0
  # grep -m1 closes the pipe early, so tac's SIGPIPE status is expected here.
  line=$(tac "$PACMAN_LOG" | grep -m1 'starting full system upgrade' || true)
  [[ -n $line ]] || return 0
  stamp=${line#[}
  stamp=${stamp%%]*}
  date -d "$stamp" +%s 2>/dev/null
}

# "name old -> new" lines, as a JSON array of {name, from, to}.
arrow_lines_to_json() {
  jq -R -s -c '
    split("\n")
    | map(select(length > 0) | capture("^(?<name>\\S+)\\s+(?<from>\\S+)\\s+->\\s+(?<to>\\S+)"))
  '
}

source_json() {
  # enabled available ok error packages-json
  jq -n -c --argjson enabled "$1" --argjson available "$2" --argjson ok "$3" \
    --arg error "$4" --argjson packages "$5" \
    '{enabled: $enabled, available: $available, ok: $ok, error: $error, packages: $packages}'
}

first_line() { grep -m1 -v '^\s*$' <<<"$1" | sed 's/^[[:space:]]*//; s/^error: //I' | cut -c1-160; }

check_system() {
  if ! command -v checkupdates >/dev/null; then
    source_json true false false "checkupdates not installed (pacman-contrib)" '[]'
    return
  fi

  local out err status
  err=$(mktemp)
  out=$(timeout "$CHECK_TIMEOUT" checkupdates --nocolor 2>"$err")
  status=$?

  # checkupdates: 0 = updates listed, 2 = none, anything else = failure.
  case $status in
    0 | 2) source_json true true true "" "$(arrow_lines_to_json <<<"$out")" ;;
    124) source_json true true false "Timed out checking system packages" '[]' ;;
    *) source_json true true false "$(first_line "$(cat "$err")" || true)" '[]' ;;
  esac
  rm -f "$err"
}

check_aur() {
  if ! command -v yay >/dev/null; then
    source_json true false true "" '[]'
    return
  fi

  local out err status message
  err=$(mktemp)
  out=$(timeout "$CHECK_TIMEOUT" yay -Qua --color never 2>"$err")
  status=$?
  message=$(grep -m1 -iE 'error|fail|could not|unable' "$err")

  # yay -Qua exits 1 when there is simply nothing to upgrade, so only stderr
  # tells a failure apart from "up to date".
  if ((status == 124)); then
    source_json true true false "Timed out checking the AUR" '[]'
  elif [[ -n $message ]]; then
    source_json true true false "$(first_line "$message")" '[]'
  else
    # Each AUR package links to its page there (the panel opens it on click).
    source_json true true true "" "$(arrow_lines_to_json <<<"$out" |
      jq -c 'map(. + {url: ("https://aur.archlinux.org/packages/" + (.name | @uri))})')"
  fi
  rm -f "$err"
}

check_mise() {
  if ! command -v mise >/dev/null; then
    source_json true false true "" '[]'
    return
  fi

  local out err status packages
  err=$(mktemp)
  # Same cooldown override as omarchy-update-mise, so the count matches what
  # an update would actually install. mise outdated also lists lazy tools that
  # were never installed, with no current version; mise up skips those, so they
  # are filtered out below.
  out=$(MISE_MINIMUM_RELEASE_AGE=0 timeout "$CHECK_TIMEOUT" mise outdated --json 2>"$err")
  status=$?

  if ((status == 124)); then
    source_json true true false "Timed out checking mise tools" '[]'
  elif ((status != 0)) || ! packages=$(jq -c '
      to_entries
      | map(select((.value.current // "") != ""))
      | map({name: .key, from: .value.current, to: (.value.latest // "")})
    ' <<<"${out:-{\}}" 2>/dev/null); then
    source_json true true false "$(first_line "$(cat "$err")" || echo "mise outdated failed")" '[]'
  else
    source_json true true true "" "$packages"
  fi
  rm -f "$err"
}

# Apps and runtimes with a newer build on their remote, across the system and
# user installations. remote-ls gives the new version; flatpak list gives the
# installed one. Runtimes often carry no version, or keep the same version for
# a rebuild, so those fall back to the branch and "new build".
check_flatpak() {
  if ! command -v flatpak >/dev/null; then
    source_json true false true "" '[]'
    return
  fi

  local out err status installed packages
  err=$(mktemp)
  out=$(timeout "$CHECK_TIMEOUT" flatpak remote-ls --updates --columns=application,branch,version 2>"$err")
  status=$?

  if ((status == 124)); then
    source_json true true false "Timed out checking Flatpak apps" '[]'
  elif ((status != 0)); then
    source_json true true false "$(first_line "$(cat "$err")" || echo "flatpak remote-ls failed")" '[]'
  else
    installed=$(flatpak list --columns=application,branch,version 2>/dev/null)
    packages=$(jq -n -c --arg updates "$out" --arg installed "$installed" '
      def rows: split("\n") | map(select(length > 0) | split("\t") | {id: .[0], branch: (.[1] // ""), version: (.[2] // "")});
      ($installed | rows | map({key: "\(.id)/\(.branch)", value: .version}) | from_entries) as $current
      | $updates | rows
      | map(
          ($current["\(.id)/\(.branch)"] // "") as $from
          | {
              name: .id,
              from: (if $from != "" then $from else .branch end),
              to: (if .version != "" and .version != $from then .version else "new build" end)
            }
        )
    ')
    source_json true true true "" "$packages"
  fi
  rm -f "$err"
}

# A git remote URL as a page a browser can open: no ".git", no user or token.
# An http(s) remote is served from the same web server, so it keeps its scheme
# and port; anything else (ssh://, git://, scp-like) opens over https on the
# default port, as the port there is the ssh or git daemon's. Prints nothing
# for local paths or anything not recognised.
browse_url() {
  local url=$1 scheme=https web=false host path
  case $url in
    https://* | http://* | ssh://* | git://*)
      if [[ $url == http://* || $url == https://* ]]; then
        scheme=${url%%://*}
        web=true
      fi
      url=${url#*://}
      host=${url%%/*}
      path=${url#*/}
      [[ $path == "$url" ]] && return 0
      ;;
    *@*:*) # scp-like: git@github.com:owner/repo.git
      url=${url#*@}
      host=${url%%:*}
      path=${url#*:}
      ;;
    *) return 0 ;;
  esac
  host=${host##*@}
  $web || host=${host%%:*}
  path=${path%/}
  path=${path%.git}
  path=${path#/}
  [[ -n $host && -n $path && $host != *[[:space:]]* && $path != *[[:space:]]* ]] || return 0
  printf '%s://%s/%s\n' "$scheme" "$host" "$path"
}

# Where to see what changed: on GitHub, a compare page from the last commit we
# share with upstream to upstream's new head (refs/update-center/upstream, as
# fetched below); elsewhere the repo page. A plugin with commits of its own
# gets the same page: the last shared commit is where upstream's new work
# starts, and its own commits are left out.
plugin_changes_url() {
  local dir=$1 remote=$2 page base new
  page=$(browse_url "$(git -C "$dir" remote get-url "$remote" 2>/dev/null)")
  [[ -n $page ]] || return 0
  if [[ $page == https://github.com/*/* ]]; then
    base=$(git -C "$dir" merge-base HEAD refs/update-center/upstream 2>/dev/null)
    new=$(git -C "$dir" rev-parse --verify --quiet refs/update-center/upstream 2>/dev/null)
    if [[ -n $base && -n $new ]]; then
      echo "$page/compare/$base...$new"
      return 0
    fi
  fi
  echo "$page"
}

# One plugin: fetch its upstream HEAD (as omarchy-plugin-update does) and print
# a {name, from, to, url?, title?} line when it is behind, or "ERR <id>" when the fetch fails.
# The result goes to its own ref, not FETCH_HEAD: omarchy-plugin-update merges
# FETCH_HEAD after showing the diff, so a check running while its prompt is open
# must not change what gets merged.
check_one_plugin() {
  local dir=$1 id behind version title remote url note="" edited=false diverged=false no_origin=false
  id=$(basename "$dir")
  # Normally "origin". A checkout that was re-pointed may only have another
  # remote: it's still checked against that one, but omarchy-plugin-update only
  # fetches origin, so it's flagged below. With no remote at all (a plugin
  # being written locally) there is nothing to check.
  remote=origin
  if ! git -C "$dir" remote get-url origin >/dev/null 2>&1; then
    remote=$(git -C "$dir" remote | head -n1)
    [[ -n $remote ]] || return 0
    no_origin=true
  fi
  if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -oBatchMode=yes" \
    timeout "$CHECK_TIMEOUT" git -C "$dir" fetch --quiet --no-write-fetch-head "$remote" "+HEAD:refs/update-center/upstream" 2>/dev/null; then
    echo "ERR $id"
    return
  fi
  behind=$(git -C "$dir" rev-list --count HEAD..refs/update-center/upstream 2>/dev/null) || behind=0
  ((behind > 0)) || return 0
  version=$(jq -r '.version // empty' "$dir/manifest.json" 2>/dev/null)
  # The manifest's name is what the panel shows; name stays the folder id,
  # which is what omarchy plugin update and the links go by.
  title=$(jq -r 'if (.name | type) == "string" then .name else empty end' "$dir/manifest.json" 2>/dev/null)
  # omarchy-plugin-update only fast-forwards from origin. A plugin with commits
  # of its own (HEAD not an ancestor of upstream), uncommitted changes to
  # tracked files, or no origin remote can't be updated by it; untracked files
  # (a __pycache__) don't get in the way. Such a plugin is listed with a note,
  # but flagged so the panel leaves it out of the waiting count.
  git -C "$dir" merge-base --is-ancestor HEAD refs/update-center/upstream 2>/dev/null || diverged=true
  [[ -n $(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null) ]] && edited=true
  if $diverged && $edited; then
    note=", has local commits and edits"
  elif $diverged; then
    note=", has local commits"
  elif $edited; then
    note=", has local edits"
  fi
  $no_origin && note+=", no origin remote"
  url=$(plugin_changes_url "$dir" "$remote")
  jq -n -c --arg name "$id" --arg from "${version:-installed}" \
    --arg to "$behind new change$( ((behind == 1)) || echo s)$note" --arg url "$url" \
    --arg title "$title" --argjson edited "$edited" --argjson diverged "$diverged" --argjson noOrigin "$no_origin" \
    '($title | gsub("[[:cntrl:]\\s\\p{Cf}]+"; " ") | ltrimstr(" ") | rtrimstr(" ")) as $title
     | {name: $name, from: $from, to: $to}
     + (if $title != "" and $title != $name then {title: $title} else {} end)
     + (if $url != "" then {url: $url} else {} end)
     + (if $edited then {localEdits: true} else {} end)
     + (if $diverged then {localCommits: true} else {} end)
     + (if $noOrigin then {noOrigin: true} else {} end)'
}

check_plugins() {
  if ! command -v git >/dev/null || [[ ! -d $PLUGINS_DIR ]]; then
    source_json true false true "" '[]'
    return
  fi

  local dir out failed packages any=false ptmp checked=0
  ptmp=$(mktemp -d)
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    any=true
    checked=$((checked + 1))
    check_one_plugin "${dir%/}" >"$ptmp/$(basename "$dir")" &
  done
  wait
  if ! $any; then
    rm -rf "$ptmp"
    source_json true false true "" '[]'
    return
  fi

  out=$(cat "$ptmp"/* 2>/dev/null)
  rm -rf "$ptmp"
  failed=$(grep '^ERR ' <<<"$out" | cut -d' ' -f2- | paste -sd, - | sed 's/,/, /g')
  packages=$(grep -v '^ERR ' <<<"$out" | jq -s -c '.')
  if [[ -n $failed ]]; then
    # The plugins that were reached are a fresh answer for themselves, so the
    # panel shows them instead of the last full result (partial). An
    # unreachable plugin can't be updated either, so it is not listed. When
    # none was reached there is nothing fresh: a plain failure.
    if (($(grep -c '^ERR ' <<<"$out") < checked)); then
      source_json true true false "Couldn't reach: $failed" "$packages" | jq -c '. + {partial: true}'
    else
      source_json true true false "Couldn't reach: $failed" "$packages"
    fi
  else
    source_json true true true "" "$packages"
  fi
}

disabled_json() { source_json false false true "" '[]'; }

full_check() {
  local skip=",$1,"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  # The checks are independent network round-trips; run them side by side.
  for source in system aur mise flatpak plugins; do
    if [[ $skip == *",$source,"* ]]; then
      disabled_json >"$tmp/$source" &
    else
      "check_$source" >"$tmp/$source" &
    fi
  done
  wait

  # Omarchy ships as the omarchy (or omarchy-dev) pacman package, so its update
  # comes from the system check; it is split out rather than counted twice.
  local omarchy_enabled=true
  [[ $skip == *",omarchy,"* ]] && omarchy_enabled=false

  jq -n -c \
    --argjson checkedAt "$(date +%s)" \
    --arg lastUpdate "$(last_update)" \
    --argjson busy "$(busy && echo true || echo false)" \
    --argjson omarchyEnabled "$omarchy_enabled" \
    --argjson omarchyInstalled "$({ pacman -Qq omarchy || pacman -Qq omarchy-dev; } >/dev/null 2>&1 && echo true || echo false)" \
    --slurpfile system "$tmp/system" \
    --slurpfile aur "$tmp/aur" \
    --slurpfile mise "$tmp/mise" \
    --slurpfile flatpak "$tmp/flatpak" \
    --slurpfile plugins "$tmp/plugins" '
    def is_omarchy: .name == "omarchy" or .name == "omarchy-dev";
    ($system[0]) as $sys
    | {
        checkedAt: $checkedAt,
        lastUpdate: (if $lastUpdate == "" then null else ($lastUpdate | tonumber) end),
        busy: $busy,
        sources: {
          system: ($sys | .packages |= map(select(is_omarchy | not))),
          aur: $aur[0],
          mise: $mise[0],
          flatpak: $flatpak[0],
          plugins: $plugins[0],
          omarchy: {
            enabled: $omarchyEnabled,
            available: ($omarchyInstalled and $sys.enabled),
            ok: $sys.ok,
            error: $sys.error,
            packages: (if $omarchyEnabled then ($sys.packages | map(select(is_omarchy))) else [] end)
          }
        }
      }
  '
}

case "${1:-}" in
  busy)
    busy && echo '{"busy":true}' || echo '{"busy":false}'
    ;;
  --skip)
    full_check "${2:-}"
    ;;
  "")
    full_check ""
    ;;
  *)
    echo "Usage: update-center-status [--skip system,aur,mise,flatpak,plugins,omarchy] | busy" >&2
    exit 2
    ;;
esac
